{
  "schemaVersion": 1,

  "_documentation": {
      "description": "Manually maintained wild Pokemon encounter pools by location and minimum building level. The template is generated from battle-type buildings in raw/buildings.json.",
      "locationKey": "Each key under locations is the game-local buildingIndex from raw/buildings.json. The buildingIndex is the authoritative connector for the location within this game.",
      "pokemonValues": "Values in level1, level2, and level3 are objects containing the game-local pokemonIndex and the corresponding displayName from mappings/pokemon-sprite-mappings.json. pokemonIndex is the authoritative connector within this game; pokemonName is included for readability and auditing.",
      "levelMeaning": {
            "level1": "Pokemon available when the location is at building level 1.",
            "level2": "Pokemon first added when the location reaches building level 2.",
            "level3": "Pokemon first added when the location reaches building level 3."
          },
      "inheritance": "Encounter levels are cumulative. A level 2 location includes the Pokemon listed under level1 and level2. A level 3 location includes the Pokemon listed under level1, level2, and level3. List each Pokemon only at the minimum level where it first becomes available.",
      "specialLocations": "Dedicated legendary encounter locations should list their Pokemon under level1, with level2 and level3 left empty, because those locations do not use normal building-level encounter progression. Any event, story, or unlock requirements are stored elsewhere.",
      "placeholder": "Every generated level initially contains an example Pokemon object to make manual editing and formatting clear. Replace every placeholder with the correct pokemonIndex and pokemonName. Use an empty array when a level adds no Pokemon.",
      "maintenance": "This file is intended to be generated once per game and then manually reviewed. Do not regenerate with --force after manual edits unless the game's building roster has changed and replacing the reviewed encounter data is intentional."
    },

