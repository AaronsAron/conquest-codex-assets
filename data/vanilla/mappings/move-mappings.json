{
  "schemaVersion": 1,

  "_documentation": {
      "description": "Maps each game move record to a stable Conquest Codex website identity. This allows move names and URLs to remain consistent across games, romhacks, and character-limited in-game naming schemes.",
      "mappingKey": "Each key under mappings is the game-local moveIndex from raw/moves.json. moveIndex is the authoritative connector between move-related files within this game.",
      "fields": {
            "websiteId": "Stable website route ID for this move. Equivalent moves should use the same websiteId across games and romhacks whenever they represent the same move.",
            "displayName": "Name displayed by Conquest Codex. This may be more descriptive than the in-game move name when abbreviations or character limits were used.",
            "notes": "Optional explanation for renamed moves, shortened names, romhack-specific variants, or other mapping decisions."
          },
      "maintenance": "This file is intended to be generated once per game and then manually reviewed. Do not regenerate with --force after manual review unless replacing existing mappings is intentional."
    },

