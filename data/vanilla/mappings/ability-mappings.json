{
  "schemaVersion": 1,

  "_documentation": {
      "description": "Maps each game ability record to a stable Conquest Codex website identity. This allows ability names and URLs to remain consistent across games, romhacks, and future naming changes.",
      "mappingKey": "Each key under mappings is the game-local abilityIndex from raw/abilities.json. abilityIndex is the authoritative connector between ability-related files within this game.",
      "fields": {
            "websiteId": "Stable website route ID for this ability. Equivalent abilities should use the same websiteId across games and romhacks whenever they represent the same ability.",
            "displayName": "Name displayed by Conquest Codex. This may be more descriptive than the source game name when abbreviations were used.",
            "notes": "Optional explanation for renamed abilities, shortened names, romhack-specific variants, or other mapping decisions."
          },
      "maintenance": "This file is intended to be generated once per game and then manually reviewed. Do not regenerate with --force after manual review unless replacing existing mappings is intentional."
    },

