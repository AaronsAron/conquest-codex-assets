{
  "schemaVersion": 1,

  "_documentation": {
    "description": "Maps each game Warrior rank record to its stable Conquest Codex website identity and Warrior Sprite Repository identity.",
    "mappingKey": "Each key under mappings is the game-local warriorIndex from raw/warriors.json. warriorIndex is the authoritative connector between raw files within this game.",
    "fields": {
      "websiteId": "Stable website route ID for this exact Warrior or Warrior rank. Equivalent records should use the same websiteId across games so users can switch games while viewing the same record.",
      "displayName": "Name displayed by Conquest Codex. The starter value comes from the human-readable name in raw/warriors.json and can be manually adjusted when required.",
      "warriorId": "Parent warriorId used by the Warrior Sprite Repository detail manifest, such as hideyoshi.",
      "variantId": "Variant or rank ID used under the selected warriorId in the Warrior Sprite Repository manifest, such as rank-ii or default.",
      "alternateSprites": "Optional sprite overrides by website usage/context. Keys are website-defined sprite slots and values are alternate sprite IDs from the selected variant. For example, 'cropped': 'alternate-default' or 'battle': 'special' (use double quotes). Leave as an empty object when default variant sprites should be used.",
      "notes": "Optional explanation for a non-obvious mapping, shortened in-game name, alternate rank, or missing sprite match."
    },
    "maintenance": "This file is intended to be generated once per game and then manually reviewed. Do not regenerate with --force after manual edits unless the game's Warrior roster has changed and overwriting the reviewed mappings is intentional."
  },

