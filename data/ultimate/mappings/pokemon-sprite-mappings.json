{
  "schemaVersion": 1,

  "_documentation": {
      "description": "Maps each game Pokemon record to its stable Conquest Codex website identity and Pokemon Sprite Repository identity.",
      "mappingKey": "Each key under mappings is the game-local pokemonIndex from raw/pokemon.json. pokemonIndex is the authoritative connector between raw files within this game.",
      "fields": {
            "websiteId": "Stable website route ID for this Pokemon record. Equivalent records should use the same websiteId across games so users can switch games while viewing the same Pokemon or form.",
            "displayName": "Name displayed by Conquest Codex. This may be more descriptive than the character-limited in-game name.",
            "pokemonId": "pokemonId used by the Pokemon Sprite Repository manifest.",
            "variantId": "variantId used under the selected pokemonId in the Pokemon Sprite Repository manifest.",
            "alternateSprites": "Optional sprite overrides by website usage/context. Keys are website-defined sprite slots and values are alternate sprite IDs from the selected variant. For example, 'cropped-left': 'alternate-default' or 'animation': 'special' (use double quotes). Leave as an empty object when default variant sprites should be used.",
            "notes": "Optional explanation for a non-obvious mapping, shortened in-game name, alternate form, or missing sprite match."
          },
      "maintenance": "This file is intended to be generated once per game and then manually reviewed. Do not regenerate with --force after manual edits unless the game's Pokemon roster has changed and overwriting the reviewed mappings is intentional."
    },

